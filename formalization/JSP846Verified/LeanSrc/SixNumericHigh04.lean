def sixCertGoodH04 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 4 l).val).map (sixPermEmb (sixCertH04 l).1) =
    sixRepAt (sixCertH04 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH04 l) := by
  unfold sixCertGoodH04
  infer_instance
theorem sixNumericHigh04 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 4 l) →
      sixCertGoodH04 l := by
  decide +kernel +revert
