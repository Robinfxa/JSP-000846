def sixCertGoodH16 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 16 l).val).map (sixPermEmb (sixCertH16 l).1) =
    sixRepAt (sixCertH16 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH16 l) := by
  unfold sixCertGoodH16
  infer_instance
theorem sixNumericHigh16 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 16 l) →
      sixCertGoodH16 l := by
  decide +kernel +revert
end JSP846Standard
