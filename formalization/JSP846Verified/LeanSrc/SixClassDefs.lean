def sixMove (tag : Fin 12) : CycleRelabel (by decide : 0 < 6) :=
  if h : tag.val < 6 then rotationRelabel ⟨tag.val,h⟩
  else reflectionRelabel ⟨tag.val-6,by have := tag.isLt; omega⟩
def sixIndexOrbitGood (I : Finset (Fin 15)) : Prop :=
  ∃ tag : Fin 12, (sixDecode I).map (sixMove tag).vertex.toEmbedding.sym2Map ∈ sixChordCatalog
instance (I : Finset (Fin 15)) : Decidable (sixIndexOrbitGood I) := by unfold sixIndexOrbitGood; infer_instance
