def sixCertGoodH08 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 8 l).val).map (sixPermEmb (sixCertH08 l).1) =
    sixRepAt (sixCertH08 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH08 l) := by
  unfold sixCertGoodH08
  infer_instance
theorem sixNumericHigh08 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 8 l) →
      sixCertGoodH08 l := by
  decide +kernel +revert
