def eightGoodTop_26_18 (S : Finset Nat) : Prop :=
  S.image (eightPermNat (eightCertTop_26_18 S).1) =
    eightRepAt (eightCertTop_26_18 S).2
instance (S : Finset Nat) : Decidable (eightGoodTop_26_18 S) := by
  unfold eightGoodTop_26_18
  infer_instance
theorem eightTop_26_18_all :
    (combTop2 26 18).all
      (fun S => decide (eightIncidentNat S → eightGoodTop_26_18 S)) = true := by
  decide +kernel
theorem eightTop_26_18_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 26 18) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
  have hb := (List.all_eq_true.mp eightTop_26_18_all) S hS
  have hp : eightIncidentNat S → eightGoodTop_26_18 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_26_18 S).1,(eightCertTop_26_18 S).2,hg⟩
