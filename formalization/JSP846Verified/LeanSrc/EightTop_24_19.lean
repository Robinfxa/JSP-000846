def eightGoodTop_24_19 (S : Finset Nat) : Prop :=
  S.image (eightPermNat (eightCertTop_24_19 S).1) =
    eightRepAt (eightCertTop_24_19 S).2
instance (S : Finset Nat) : Decidable (eightGoodTop_24_19 S) := by
  unfold eightGoodTop_24_19
  infer_instance
theorem eightTop_24_19_all :
    (combTop2 24 19).all
      (fun S => decide (eightIncidentNat S → eightGoodTop_24_19 S)) = true := by
  decide +kernel
theorem eightTop_24_19_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 24 19) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
  have hb := (List.all_eq_true.mp eightTop_24_19_all) S hS
  have hp : eightIncidentNat S → eightGoodTop_24_19 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_24_19 S).1,(eightCertTop_24_19 S).2,hg⟩
