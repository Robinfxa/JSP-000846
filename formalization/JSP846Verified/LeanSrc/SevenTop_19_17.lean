def sevenGoodTop_19_17 (S : Finset Nat) : Prop :=
  S.image (sevenPermNat (sevenCertTop_19_17 S).1) =
    sevenRepAt (sevenCertTop_19_17 S).2
instance (S : Finset Nat) : Decidable (sevenGoodTop_19_17 S) := by
  unfold sevenGoodTop_19_17
  infer_instance
theorem sevenTop_19_17_all :
    (combTop2 19 17).all
      (fun S => decide (sevenIncidentNat S → sevenGoodTop_19_17 S)) = true := by
  decide +kernel
theorem sevenTop_19_17_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 19 17) (hinc : sevenIncidentNat S) :
    ∃ tag : Fin 14, ∃ rep : Fin 333,
      S.image (sevenPermNat tag) = sevenRepAt rep := by
  have hb := (List.all_eq_true.mp sevenTop_19_17_all) S hS
  have hp : sevenIncidentNat S → sevenGoodTop_19_17 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(sevenCertTop_19_17 S).1,(sevenCertTop_19_17 S).2,hg⟩
end JSP846Standard
