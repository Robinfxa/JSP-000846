theorem sixPerm_left (tag : Fin 12) (i : Fin 15) :
    sixPermInv tag (sixPerm tag i) = i := by decide +kernel +revert
theorem sixPerm_injective (tag : Fin 12) : Function.Injective (sixPerm tag) := by
  intro a b h
  have hh := congrArg (sixPermInv tag) h
  simpa only [sixPerm_left] using hh
def sixPermEmb (tag : Fin 12) : Fin 15 ↪ Fin 15 := ⟨sixPerm tag, sixPerm_injective tag⟩
def sixFastIncident (I : Finset (Fin 15)) : Prop :=
  ∀ v : Fin 6, ∃ e ∈ I, sixIdxU e = v ∨ sixIdxV e = v
instance (I : Finset (Fin 15)) : Decidable (sixFastIncident I) := by unfold sixFastIncident; infer_instance
def sixFastCandidates : Finset (Finset (Fin 15)) :=
  (Finset.univ.powersetCard 5).filter sixFastIncident
