def sevenGoodTop_17_16 (S : Finset Nat) : Prop :=
  S.image (sevenPermNat (sevenCertTop_17_16 S).1) =
    sevenRepAt (sevenCertTop_17_16 S).2
instance (S : Finset Nat) : Decidable (sevenGoodTop_17_16 S) := by
  unfold sevenGoodTop_17_16
  infer_instance
theorem sevenTop_17_16_all :
    (combTop2 17 16).all
      (fun S => decide (sevenIncidentNat S → sevenGoodTop_17_16 S)) = true := by
  decide +kernel
theorem sevenTop_17_16_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 17 16) (hinc : sevenIncidentNat S) :
    ∃ tag : Fin 14, ∃ rep : Fin 333,
      S.image (sevenPermNat tag) = sevenRepAt rep := by
  have hb := (List.all_eq_true.mp sevenTop_17_16_all) S hS
  have hp : sevenIncidentNat S → sevenGoodTop_17_16 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(sevenCertTop_17_16 S).1,(sevenCertTop_17_16 S).2,hg⟩
end JSP846Standard
