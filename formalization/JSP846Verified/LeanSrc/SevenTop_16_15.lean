def sevenGoodTop_16_15 (S : Finset Nat) : Prop :=
  S.image (sevenPermNat (sevenCertTop_16_15 S).1) =
    sevenRepAt (sevenCertTop_16_15 S).2
instance (S : Finset Nat) : Decidable (sevenGoodTop_16_15 S) := by
  unfold sevenGoodTop_16_15
  infer_instance
theorem sevenTop_16_15_all :
    (combTop2 16 15).all
      (fun S => decide (sevenIncidentNat S → sevenGoodTop_16_15 S)) = true := by
  decide +kernel
theorem sevenTop_16_15_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 16 15) (hinc : sevenIncidentNat S) :
    ∃ tag : Fin 14, ∃ rep : Fin 333,
      S.image (sevenPermNat tag) = sevenRepAt rep := by
  have hb := (List.all_eq_true.mp sevenTop_16_15_all) S hS
  have hp : sevenIncidentNat S → sevenGoodTop_16_15 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(sevenCertTop_16_15 S).1,(sevenCertTop_16_15 S).2,hg⟩
end JSP846Standard
