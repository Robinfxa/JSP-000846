def sixCertGoodH01 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 1 l).val).map (sixPermEmb (sixCertH01 l).1) =
    sixRepAt (sixCertH01 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH01 l) := by
  unfold sixCertGoodH01
  infer_instance
theorem sixNumericHigh01 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 1 l) →
      sixCertGoodH01 l := by
  decide +kernel +revert
