def sevenGoodTop_20_19 (S : Finset Nat) : Prop :=
  S.image (sevenPermNat (sevenCertTop_20_19 S).1) =
    sevenRepAt (sevenCertTop_20_19 S).2
instance (S : Finset Nat) : Decidable (sevenGoodTop_20_19 S) := by
  unfold sevenGoodTop_20_19
  infer_instance
theorem sevenTop_20_19_all :
    (combTop2 20 19).all
      (fun S => decide (sevenIncidentNat S → sevenGoodTop_20_19 S)) = true := by
  decide +kernel
theorem sevenTop_20_19_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 20 19) (hinc : sevenIncidentNat S) :
    ∃ tag : Fin 14, ∃ rep : Fin 333,
      S.image (sevenPermNat tag) = sevenRepAt rep := by
  have hb := (List.all_eq_true.mp sevenTop_20_19_all) S hS
  have hp : sevenIncidentNat S → sevenGoodTop_20_19 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(sevenCertTop_20_19 S).1,(sevenCertTop_20_19 S).2,hg⟩
end JSP846Standard
