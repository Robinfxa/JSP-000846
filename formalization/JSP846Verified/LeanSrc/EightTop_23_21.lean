def eightGoodTop_23_21 (S : Finset Nat) : Prop :=
  S.image (eightPermNat (eightCertTop_23_21 S).1) =
    eightRepAt (eightCertTop_23_21 S).2
instance (S : Finset Nat) : Decidable (eightGoodTop_23_21 S) := by
  unfold eightGoodTop_23_21
  infer_instance
theorem eightTop_23_21_all :
    (combTop2 23 21).all
      (fun S => decide (eightIncidentNat S → eightGoodTop_23_21 S)) = true := by
  decide +kernel
theorem eightTop_23_21_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 23 21) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
  have hb := (List.all_eq_true.mp eightTop_23_21_all) S hS
  have hp : eightIncidentNat S → eightGoodTop_23_21 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_23_21 S).1,(eightCertTop_23_21 S).2,hg⟩
