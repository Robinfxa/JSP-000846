def tenMove (tag : Fin 20) : CycleRelabel (by decide : 0 < 10) :=
  if h : tag.val < 10 then rotationRelabel ⟨tag.val,h⟩
  else reflectionRelabel ⟨tag.val - 10, by have := tag.isLt; omega⟩
