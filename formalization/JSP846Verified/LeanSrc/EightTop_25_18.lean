def eightGoodTop_25_18 (S : Finset Nat) : Prop :=
  S.image (eightPermNat (eightCertTop_25_18 S).1) =
    eightRepAt (eightCertTop_25_18 S).2
instance (S : Finset Nat) : Decidable (eightGoodTop_25_18 S) := by
  unfold eightGoodTop_25_18
  infer_instance
theorem eightTop_25_18_all :
    (combTop2 25 18).all
      (fun S => decide (eightIncidentNat S → eightGoodTop_25_18 S)) = true := by
  decide +kernel
theorem eightTop_25_18_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 25 18) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
  have hb := (List.all_eq_true.mp eightTop_25_18_all) S hS
  have hp : eightIncidentNat S → eightGoodTop_25_18 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_25_18 S).1,(eightCertTop_25_18 S).2,hg⟩
end JSP846Standard
