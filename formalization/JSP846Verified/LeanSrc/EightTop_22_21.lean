def eightGoodTop_22_21 (S : Finset Nat) : Prop :=
  S.image (eightPermNat (eightCertTop_22_21 S).1) =
    eightRepAt (eightCertTop_22_21 S).2
instance (S : Finset Nat) : Decidable (eightGoodTop_22_21 S) := by
  unfold eightGoodTop_22_21
  infer_instance
theorem eightTop_22_21_all :
    (combTop2 22 21).all
      (fun S => decide (eightIncidentNat S → eightGoodTop_22_21 S)) = true := by
  decide +kernel
theorem eightTop_22_21_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 22 21) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
  have hb := (List.all_eq_true.mp eightTop_22_21_all) S hS
  have hp : eightIncidentNat S → eightGoodTop_22_21 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_22_21 S).1,(eightCertTop_22_21 S).2,hg⟩
end JSP846Standard
