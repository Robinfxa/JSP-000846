def sixCertGoodH00 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 0 l).val).map (sixPermEmb (sixCertH00 l).1) =
    sixRepAt (sixCertH00 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH00 l) := by
  unfold sixCertGoodH00
  infer_instance
theorem sixNumericHigh00 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 0 l) →
      sixCertGoodH00 l := by
  decide +kernel +revert
end JSP846Standard
