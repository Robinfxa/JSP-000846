def sixCertGoodH02 (l : Fin 1024) : Prop :=
  (decodeMask (sixHLCode 2 l).val).map (sixPermEmb (sixCertH02 l).1) =
    sixRepAt (sixCertH02 l).2
instance (l : Fin 1024) : Decidable (sixCertGoodH02 l) := by
  unfold sixCertGoodH02
  infer_instance
theorem sixNumericHigh02 :
    ∀ l : Fin 1024, sixMaskCandidateCode (sixHLCode 2 l) →
      sixCertGoodH02 l := by
  decide +kernel +revert
