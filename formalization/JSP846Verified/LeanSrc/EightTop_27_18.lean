      (fun S => decide (eightIncidentNat S → eightGoodTop_27_18 S)) = true := by
  decide +kernel
theorem eightTop_27_18_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 27 18) (hinc : eightIncidentNat S) :
    ∃ tag : Fin 16, ∃ rep : Fin 417,
      S.image (eightPermNat tag) = eightRepAt rep := by
