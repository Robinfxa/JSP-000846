  have hp : eightIncidentNat S → eightGoodTop_27_18 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(eightCertTop_27_18 S).1,(eightCertTop_27_18 S).2,hg⟩
