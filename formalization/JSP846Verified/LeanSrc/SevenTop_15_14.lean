def sevenGoodTop_15_14 (S : Finset Nat) : Prop :=
  S.image (sevenPermNat (sevenCertTop_15_14 S).1) =
    sevenRepAt (sevenCertTop_15_14 S).2
instance (S : Finset Nat) : Decidable (sevenGoodTop_15_14 S) := by
  unfold sevenGoodTop_15_14
  infer_instance
theorem sevenTop_15_14_all :
    (combTop2 15 14).all
      (fun S => decide (sevenIncidentNat S → sevenGoodTop_15_14 S)) = true := by
  decide +kernel
theorem sevenTop_15_14_orbit (S : Finset Nat)
    (hS : S ∈ combTop2 15 14) (hinc : sevenIncidentNat S) :
    ∃ tag : Fin 14, ∃ rep : Fin 333,
      S.image (sevenPermNat tag) = sevenRepAt rep := by
  have hb := (List.all_eq_true.mp sevenTop_15_14_all) S hS
  have hp : sevenIncidentNat S → sevenGoodTop_15_14 S :=
    of_decide_eq_true hb
  have hg := hp hinc
  exact ⟨(sevenCertTop_15_14 S).1,(sevenCertTop_15_14 S).2,hg⟩
end JSP846Standard
#print axioms JSP846Standard.sevenTop_15_14_orbit
